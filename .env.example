# Hasła tylko z liter i cyfr (trafiają do URL-a bazy). Wygeneruj: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
PIXGYM_APP_DB_PASSWORD=change-me
# Klucz AES-256 do zdjęć sylwetki (base64, 32 bajty). Utrata klucza = utrata zdjęć.
# Wygeneruj: openssl rand -base64 32
PIXGYM_PHOTO_KEY=change-me
# Klucz do podpisu tokenów logowania. Zmiana = wszyscy muszą zalogować się ponownie.
# Wygeneruj: openssl rand -hex 32
PIXGYM_SECRET_KEY=change-me
